# Supabase — projeto SEPARADO do nexaigen-educa (este é interno, da NEXAIGEN,
# não é multi-tenant e não deve compartilhar banco com o produto vendido).
# NEXT_PUBLIC_SUPABASE_ANON_KEY não é mais usada em runtime por nenhuma rota
# desde a rodada de correção do achado crítico de segurança (login próprio,
# ver lib/auth.ts) — mantida aqui só porque createClient (browser, se algum
# dia voltar a existir) ainda pediria; toda leitura/escrita do servidor usa
# SUPABASE_SERVICE_ROLE_KEY (supabaseAdmin()).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-FINANCEIRO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Segredo de assinatura dos access tokens (JWT, HS256) do login da equipe
# NEXAIGEN (lib/auth.ts) — rodada de correção de achado crítico de
# segurança: antes desta rodada, NÃO EXISTIA login nenhum, toda rota estava
# aberta. Gere um valor longo e aleatório (ex.: openssl rand -hex 32) e
# NUNCA reaproveite entre ambientes — trocar este valor invalida todo
# access token já emitido (força novo login geral, não é uma falha, é o
# comportamento esperado). Sem esta variável configurada, lib/auth.ts lança
# na primeira tentativa de gerar/verificar um token.
JWT_SECRET=

# URL pública deste deployment. Não é usada em runtime no momento
# (app/(protegido)/alertas/page.tsx deixou de fazer self-fetch pra própria
# API nesta rodada de correção de segurança, consultando supabaseAdmin()
# direto em vez disso — self-fetch de Server Component pra própria API
# não repassa cookie automaticamente, ver o comentário naquele arquivo) —
# mantida documentada caso uma página futura precise montar uma URL
# absoluta de si mesma. Local: http://localhost:3001 (note a porta — este
# projeto roda na 3001 para poder rodar junto com o nexaigen-educa na 3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Segredo usado para autenticar a chamada do cron externo (Vercel Cron, etc.)
# em /api/cron/verificar-prazos — evita que qualquer um dispare o job.
CRON_SECRET=troque-por-um-valor-aleatorio-longo

# E-mail via Resend (https://resend.com) — canal único, usado em DOIS lugares
# desde a rodada de "e-mails bem lindos e cobrança automática":
#   1. lib/notificacao-interna.ts — alerta INTERNO pro time de cobrança,
#      só quando um alerta atraso_60_dias é criado. Vai pra COBRANCA_EMAIL_DESTINO.
#   2. lib/notificacaoCliente.ts — e-mail PARA O CONTATO DA PREFEITURA
#      cliente (contato_email em cliente_prefeitura), disparado nos 4
#      estágios de alerta, só na TRANSIÇÃO de estado (nunca todo dia
#      enquanto o estado persistir — ver comentário em lib/notificacaoCliente.ts).
#      Todo e-mail deste tipo vai também em BCC (nunca CC visível pro
#      cliente) pra COBRANCA_EMAIL_DESTINO, pra visibilidade total do que
#      sai automaticamente em nome da empresa.
# Crie uma API key e verifique o domínio remetente antes de ativar.
RESEND_API_KEY=
ALERTA_EMAIL_REMETENTE=alertas@nexaigen.com.br
COBRANCA_EMAIL_DESTINO=cobranca@nexaigen.com.br

# IMPORTANTE: NÃO existe campo de senha de portal de prefeitura no banco —
# de propósito. Credenciais de login em sistemas de terceiros devem ficar
# num gerenciador de senhas (1Password/Bitwarden), nunca em texto plano
# num banco de dados. Ver nota em supabase/schema.sql.
