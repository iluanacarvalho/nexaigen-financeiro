# Postgres direto (sem Supabase, desde a rodada de migração de
# infraestrutura) — mesma arquitetura do projeto irmão nexaigen-educa,
# pedido explícito da Luana: os dois projetos usando a MESMA forma de
# acessar banco, sem depender de um projeto Supabase configurado à parte
# (foi exatamente isso que bloqueou o primeiro login real por uma rodada
# inteira — um projeto Supabase antigo, esquecido, com a URL nunca
# preenchida em .env.local). Local via Docker Compose:
#   docker compose up -d && npm run migrate
# Em produção, aponta pro Postgres gerenciado real (Railway, RDS, Neon,
# etc.) — nunca compartilhado com o banco do repo irmão nexaigen-educa
# (mono-tenant aqui, multi-tenant lá — dois negócios diferentes).
DATABASE_URL=postgres://nexaigen:nexaigen_dev_local@localhost:5435/nexaigen_financeiro

# Segredo de assinatura dos access tokens (JWT, HS256) do login da equipe
# NEXAIGEN (lib/auth.ts) — rodada de correção de achado crítico de
# segurança: antes desta rodada, NÃO EXISTIA login nenhum, toda rota estava
# aberta. Gere um valor longo e aleatório (ex.: openssl rand -hex 32) e
# NUNCA reaproveite entre ambientes — trocar este valor invalida todo
# access token já emitido (força novo login geral, não é uma falha, é o
# comportamento esperado). Sem esta variável configurada, lib/auth.ts lança
# na primeira tentativa de gerar/verificar um token.
JWT_SECRET=

# URL pública deste deployment. Não é usada em runtime no momento
# (app/(protegido)/alertas/page.tsx deixou de fazer self-fetch pra própria
# API, consultando o banco (lib/db.ts#query) direto em vez disso —
# self-fetch de Server Component pra própria API não repassa cookie
# automaticamente, ver o comentário naquele arquivo) — mantida
# documentada caso uma página futura precise montar uma URL absoluta de
# si mesma. Local: http://localhost:3001 (note a porta — este
# projeto roda na 3001 para poder rodar junto com o nexaigen-educa na 3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Segredo usado para autenticar a chamada do cron externo (Vercel Cron, etc.)
# em /api/cron/verificar-prazos — evita que qualquer um dispare o job.
CRON_SECRET=troque-por-um-valor-aleatorio-longo

# E-mail via Resend (https://resend.com) — canal único, usado em TRÊS lugares:
#   1. lib/notificacao-interna.ts — alerta INTERNO pro time de cobrança,
#      só quando um alerta atraso_60_dias é criado. Vai pra COBRANCA_EMAIL_DESTINO.
#   2. lib/notificacaoCliente.ts — e-mail PARA O CONTATO DA PREFEITURA
#      cliente (contato_email em cliente_prefeitura), disparado nos 4
#      estágios de alerta, só na TRANSIÇÃO de estado (nunca todo dia
#      enquanto o estado persistir — ver comentário em lib/notificacaoCliente.ts).
#      Todo e-mail deste tipo vai também em BCC (nunca CC visível pro
#      cliente) pra COBRANCA_EMAIL_DESTINO, pra visibilidade total do que
#      sai automaticamente em nome da empresa.
#   3. lib/alertaErroSistema.ts — alerta de FALHA TÉCNICA de sistema (não
#      de negócio), com debounce de 30 minutos por categoria — ver
#      ALERTA_SISTEMA_EMAILS_DESTINO abaixo.
# Crie uma API key e verifique o domínio remetente antes de ativar.
RESEND_API_KEY=
ALERTA_EMAIL_REMETENTE=alertas@nexaigen.com.br
# Aceita múltiplos e-mails separados por vírgula (ex.:
# "cobranca@nexaigen.com.br,outra-pessoa@nexaigen.com.br").
COBRANCA_EMAIL_DESTINO=cobranca@nexaigen.com.br

# Alerta de FALHA TÉCNICA de sistema (lib/alertaErroSistema.ts) — diferente
# dos alertas de negócio acima: cobre bucket (Railway) fora do ar, a
# PRÓPRIA Resend falhando ao enviar os alertas 1/2 acima, CRON_SECRET
# ausente (o job diário inteiro para de rodar) e qualquer exceção não
# tratada chegando ao servidor (instrumentation.ts#onRequestError).
# Debounce de 30 minutos por categoria — persistido em Postgres
# (log_alerta_sistema, 0003_log_alerta_sistema.sql), nunca um e-mail por
# tentativa individual enquanto uma falha persiste. Aceita múltiplos
# e-mails separados por vírgula, mesmo tratamento de COBRANCA_EMAIL_DESTINO
# acima.
ALERTA_SISTEMA_EMAILS_DESTINO=

# Armazenamento do PDF da nota fiscal (POST/GET /api/notas/[id]/arquivo)
# — Railway Buckets (S3-compatível), MESMO módulo (lib/armazenamentoObjetos.ts)
# e MESMAS env vars já usadas pelo projeto irmão nexaigen-educa pra upload
# de prestação de contas de convênio — reaproveitado aqui tal e qual, não
# duplicado. Nomes prefixados RAILWAY_BUCKET_* pra não colidir com outras
# env vars. Sem as 4 primeiras configuradas juntas, upload/download
# devolvem 502 (fail-safe — nunca uma exceção não tratada, ver
# lib/armazenamentoObjetos.ts). RAILWAY_BUCKET_REGION cai pra "auto" se
# ausente; RAILWAY_BUCKET_FORCE_PATH_STYLE cai pra "false" se ausente
# (confira a aba Credentials do bucket real pra saber qual usar).
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_REGION=
RAILWAY_BUCKET_FORCE_PATH_STYLE=

# IMPORTANTE: NÃO existe campo de senha de portal de prefeitura no banco —
# de propósito. Credenciais de login em sistemas de terceiros devem ficar
# num gerenciador de senhas (1Password/Bitwarden), nunca em texto plano
# num banco de dados. Ver nota em db/migrations/0001_initial.sql.
