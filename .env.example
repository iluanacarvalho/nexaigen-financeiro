# Supabase — projeto SEPARADO do nexaigen-educa (este é interno, da NEXAIGEN,
# não é multi-tenant e não deve compartilhar banco com o produto vendido).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-FINANCEIRO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL pública deste deployment — usada por app/alertas/page.tsx para chamar
# a própria API Route. Local: http://localhost:3001 (note a porta — este
# projeto roda na 3001 para poder rodar junto com o nexaigen-educa na 3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Segredo usado para autenticar a chamada do cron externo (Vercel Cron, etc.)
# em /api/cron/verificar-prazos — evita que qualquer um dispare o job.
CRON_SECRET=troque-por-um-valor-aleatorio-longo

# Notificação de escalonamento (60 dias de atraso) — canal único: e-mail via Resend
# (https://resend.com). Crie uma API key e verifique o domínio remetente antes de ativar.
RESEND_API_KEY=
ALERTA_EMAIL_REMETENTE=alertas@nexaigen.com.br
COBRANCA_EMAIL_DESTINO=cobranca@nexaigen.com.br

# IMPORTANTE: NÃO existe campo de senha de portal de prefeitura no banco —
# de propósito. Credenciais de login em sistemas de terceiros devem ficar
# num gerenciador de senhas (1Password/Bitwarden), nunca em texto plano
# num banco de dados. Ver nota em supabase/schema.sql.
