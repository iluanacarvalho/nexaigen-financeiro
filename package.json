{
  "name": "nexaigen-financeiro",
  "version": "0.1.0",
  "private": true,
  "description": "NEXAIGEN — Controle interno de contratos, notas fiscais, atesto e cobrança (uso da própria NEXAIGEN, não do cliente prefeitura)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "bootstrap-equipe-nexaigen": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap-equipe-nexaigen.ts",
    "recalcular-hash-versoes": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/recalcular-hash-versoes-pdf.ts",
    "gerar-mapa-brasil": "tsx scripts/gerar-mapa-brasil.ts",
    "gerar-base-municipios": "tsx scripts/gerar-base-municipios.ts",
    "importar-municipios": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/importar-municipios.ts",
    "importar-entidades-csv": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/importar-entidades-csv.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@smithy/node-http-handler": "^4.12.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "next": "16.4.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.24.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vitest": "^4.1.12"
  }
}
